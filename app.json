{
  "expo": {
    "name": "RussianSpeak",
    "slug": "russianspeak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hyrum.russianspeak",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "russianspeak",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "RussianSpeak uses the microphone so you can record and compare your pronunciation."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "RussianSpeak uses the microphone so you can check your pronunciation.",
          "speechRecognitionPermission": "RussianSpeak uses speech recognition to check your pronunciation."
        }
      ]
    ]
  }
}
